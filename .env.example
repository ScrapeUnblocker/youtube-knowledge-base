# Copy to .env (never commit it) or set these as GitHub repository secrets.
# Only SCRAPEUNBLOCKER_KEY is required; each destination switches on when its secret is set.
SCRAPEUNBLOCKER_KEY=your_key_here

# Obsidian: no secret needed for the folder in this repo. To write into another
# GitHub repo (destinations.obsidian.repo), a fine-grained token with Contents read/write:
VAULT_GITHUB_TOKEN=

# Notion: an internal integration token, and the database shared with it
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Qdrant Cloud (or any Qdrant server); for a local folder use destinations.qdrant.path
QDRANT_URL=
QDRANT_API_KEY=

# Chat pings
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
